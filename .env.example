# Copy this file to .env and fill in real values as you enable each service.
# Every integration is OPTIONAL -- the app runs fully in mock mode with no
# variables set at all. See app/config.py for exactly how each flag is derived.

# --- Sentinel Hub (real satellite imagery) ---


# --- Qwen-VL (set to true only once requirements-full.txt is installed
#     and you have GPU resources; otherwise leave false for the pixel
#     heuristic fallback) ---
QWEN_ENABLED=false
QWEN_MODEL_NAME=Qwen/Qwen2-VL-2B-Instruct

# --- Google Cloud (Translation + Text-to-Speech) ---
GOOGLE_APPLICATION_CREDENTIALS=

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Celery / Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Database (defaults to local SQLite; swap for Postgres in production) ---
DATABASE_URL=sqlite:///./mehfooz.db

# --- Risk tuning (placeholders -- validate against real GLOF events) ---
RISK_CRITICAL_THRESHOLD=0.65
RISK_WEIGHT_AREA=0.5
RISK_WEIGHT_CHANNEL=0.3
RISK_WEIGHT_MELT=0.2
